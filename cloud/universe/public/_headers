# Headers for files the asset store serves without the Worker (styles, the pages' bundles
# under /_next/static/, brand SVGs, fonts, install.sh). No page is a file: the Worker renders
# every page and sets the security headers of docs/reference/tau-universe.md §2 itself
# (src/pages.ts, worker/index.ts).
#
# The page policy goes on HTML only: an SVG loaded as an image keeps its own <style>
# (the hero's motion), which a `style-src 'self'` on the SVG response could block.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/static/fonts/*
  Cache-Control: public, max-age=604800

/brand/*
  Cache-Control: public, max-age=86400

# The one-line installer (ADR 0014): plain text, so a browser shows it for reading and
# `curl -fsSL .../install.sh | sh` runs it.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300
