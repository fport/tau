<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- tau: şarjdayken sistem uyumasın (caffeinate -s sadece AC güçte geçerlidir).
     Pildeyken normal uyur; kapak kapanınca yine uyur. TauBar gelince bu ajan kaldırılacak. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tau.keepawake</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
