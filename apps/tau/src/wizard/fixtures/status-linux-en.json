    {
      "id": "guard",
      "label": "Owner guard",
      "description": "tau answers only while you are at the Mac (face check, Touch ID)",
      "package": "tau-guard",
      "lockstep": true,
      "platforms": [
        "darwin"
      ],
      "available": false,
      "unavailable_reason": "macOS only: the guard uses the Mac's built-in camera and Touch ID",
      "default": false,
      "advanced": false,
