# Copy to .env and fill in your own values. .env is gitignored; this file only holds
# variable names and example values, never real ones.

# --- Remote access (L0): reference values, infra/remote/doctor.sh prints them live ---
TAU_TAILNET=tailXXXXXX.ts.net
TAU_MAC_HOSTNAME=my-mac
TAU_MAC_MAGICDNS=my-mac.tailXXXXXX.ts.net
TAU_MAC_TAILNET_IP=100.x.y.z
TAU_MAC_SSH_HOST_KEY_FP=SHA256:...
TAU_PHONE_HOSTNAME=my-phone
TAU_PHONE_TAILNET_IP=100.x.y.z
TAU_PHONE_SSH_KEY_FP=SHA256:...

# --- Agent (L1): model credentials. Uncomment what you use; tau.toml says which role needs what.
# Bedrock (optional): AWS_REGION plus one of AWS_PROFILE |
# AWS_ACCESS_KEY_ID+AWS_SECRET_ACCESS_KEY | AWS_BEARER_TOKEN_BEDROCK
# AWS_REGION=eu-central-1
# AWS_PROFILE=tau
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=...
# AWS_BEARER_TOKEN_BEDROCK=...
# Anthropic. A key that is not scoped to a workspace also needs the workspace id
# (Console → Settings → Workspaces).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=wrksp_...

# OpenAI and Google Gemini (ADR 0011): set the one tau.toml uses.
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...                  # GOOGLE_API_KEY works too
# Ollama for the local role: unset means this machine; the Mac over the tailnet otherwise.
# TAU_OLLAMA_URL=http://my-mac.tailXXXXXX.ts.net:11434

# --- Agent (L1): roots and identity. Defaults are shown; set only what differs.
# TAU_HOME=/path/to/tau               # tau.toml, persona/, tools/ (default: cwd with tau.toml, else ~/.tau)
# TAU_DATA_DIR=~/.local/share/tau     # sessions, hub state, logs
# TAU_PROFILE=home                    # home | travel | sport
# TAU_ROLE=hub                        # hub | node
# TAU_HUB_PORT=7877                   # overrides [hub].control_port
# TAU_LANG=en                         # en | tr; UI language, overrides [ui].language (tau --lang does the same)

# --- Access and data (L3): Telegram, polled directly by the hub (ADR 0006). No webhook.
# Bot token from @BotFather (/newbot); the chat ids the bot answers, comma-separated.
# Messages from any other chat are dropped unanswered. `tau telegram pair` writes both for you.
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_ALLOWED_CHAT_IDS=123456789

# --- tau network (ADR 0007): the tau's spine Worker (cloud/spine); see docs/guides/tau-network.md.
# TAU_SPINE_URL=https://tau.example.com    # http://127.0.0.1:8787 while developing with `bun run dev`
# TAU_SPINE_TOKEN=...                      # the spine's HUB_TOKEN secret (set by `tau net spine deploy`)
# TAU_NET_IDENTITY=...                     # cloud mode: TAU_DATA_DIR/net/identity.json as base64url JSON
# TAU_NET_ALLOW_INSECURE=1                 # development only: http to localhost/127.0.0.1 peers
# CLOUDFLARE_API_TOKEN=...                 # `tau net spine deploy`: the API token it asks for and saves
# CLOUDFLARE_ACCOUNT_ID=0123456789abcdef0123456789abcdef  # optional: the account for the spine
