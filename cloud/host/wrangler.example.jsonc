// tau-host: a Worker that hosts taus. GitHub sign-in, one Durable Object per tau (the brain,
// its settings, sessions, sub-taus, approvals and spend), the owner's app at /app, a chat
// page for each public web sub-tau at /@<handle>/<name>, and each tau's card and inbox on
// the tau network at /@<handle>/.well-known/tau.json and /@<handle>/net/inbox.
//
// Decision: docs/adr/0013 (§2, §4, §5). Setup: README.md in this directory.
//
// Do not edit this file for your own deployment: `pnpm run configure [--route HOST]` copies
// it to the gitignored `wrangler.jsonc`. No hostnames, client ids or account ids belong here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tau-host",
  "main": "src/index.ts",
  // The newest date the test runtime (@cloudflare/vitest-pool-workers) supports.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Bundles the app's and the visitor page's scripts and copies the styles into
  // public/app/assets/ (gitignored). `wrangler dev` and `wrangler deploy` run it first.
  "build": {
    "command": "node scripts/build.mjs",
    "watch_dir": "client"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // The Worker answers every page and the API (security headers, sessions); only the
    // bundled scripts and styles under /app/assets/ come straight from the asset store,
    // with the headers in public/_headers.
    "run_worker_first": ["/*", "!/app/assets/*"]
  },
  "vars": {
    // The client id of your GitHub OAuth App (public; its secret is the secret
    // GITHUB_CLIENT_SECRET). The App's callback URL is https://<host>/auth/callback.
    "GITHUB_CLIENT_ID": "",
    // Who may create an account: "open" (anyone with a GitHub account), a comma list of
    // GitHub logins ("alice,bob"; an own host lists only its owner), or "" (nobody new).
    // Existing accounts can always sign in.
    "SIGNUP": "",
    // The host's public name, e.g. "tau.example.com". Empty means "the host of the request
    // URL", which is right for `tau-host.<subdomain>.workers.dev` and for `wrangler dev`.
    // `pnpm run configure --route HOST` sets it to HOST. It is also the host part of every
    // hosted tau's network address, `<PUBLIC_HOST>/@<handle>`: set it before taus join the
    // network, because another host name gives every tau a new address.
    "PUBLIC_HOST": "",
    // "1" allows a password-less sign-in, and only for requests to localhost or 127.0.0.1.
    // Development and tests only; `.dev.vars` turns it on for `wrangler dev`.
    "DEV_LOGIN": "0",
    // "1" offers the scripted `fake` provider (no key, no cost). Development and tests only.
    "FAKE_PROVIDER": "0",
    // "1" lets taus talk plain http to peers on localhost or 127.0.0.1 (a local hub's spine
    // in development). No other host ever uses http.
    "ALLOW_INSECURE_PEERS": "0"
    // The universe hosted taus join, list their public sub-taus in and report to (ADR 0010),
    // e.g. "tau.example.com". Left out: the host's own public host, where the universe is the
    // front door (tau.getporti.com). "" switches the universe off.
    // `pnpm run configure --universe HOST|off` writes it.
    //   "UNIVERSE": "",
    // Secrets (never here: `npx wrangler secret put NAME`, or `.dev.vars` for `wrangler dev`):
    //   GITHUB_CLIENT_SECRET   the OAuth App's client secret
    //   VAULT_KEY              32 random bytes, base64url; seals every provider key at rest
  },
  "durable_objects": {
    "bindings": [
      // One instance ("accounts"): GitHub id <-> handle, sessions and sign-in states.
      { "name": "ACCOUNTS", "class_name": "Accounts" },
      // One instance per handle: everything of that tau.
      { "name": "TAU", "class_name": "Tau" }
    ]
  },
  // The inbox's flood guards (docs/reference/tau-network.md §4), before anything that costs
  // a subrequest or a Durable Object call: envelopes per client IP (an IPv6 address counted
  // by its /64) and per sender and hosted tau, each a minute. A namespace_id is shared by
  // every Worker of an account that uses it; these differ from the spine's (10501, 10502).
  // Without the bindings the checks are skipped (logged once).
  "ratelimits": [
    { "name": "INBOX_IP_LIMIT", "namespace_id": "10601", "simple": { "limit": 60, "period": 60 } },
    {
      "name": "INBOX_SENDER_LIMIT",
      "namespace_id": "10602",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // Optional: the universe Worker as a service binding, when it runs on the same Cloudflare
  // zone as this host (tau.getporti.com). Requests to the UNIVERSE host then go through it
  // instead of a public fetch:
  //   "services": [{ "binding": "UNIVERSE_SERVICE", "service": "tau-universe" }],
  // SQLite-backed classes are the kind the Free plan allows.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Accounts", "Tau"] }],
  // `wrangler dev` only.
  "dev": { "ip": "127.0.0.1", "port": 8791 }
  // A custom domain (optional; `pnpm run configure --route tau.example.com` does this):
  //   "routes": [{ "pattern": "tau.example.com", "custom_domain": true }]
  // and set PUBLIC_HOST to "tau.example.com". The zone must be on your Cloudflare account.
}
