# Headers for the files the asset store serves without the Worker: the bundled scripts and
# the styles under /app/assets/ (built by `bun run build`). Every page, the API and the 404
# answers get their headers from the Worker (src/pages.ts).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/app/assets/*
  Cache-Control: public, max-age=300
