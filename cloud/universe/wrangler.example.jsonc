// tau universe: the public site (landing page, /how-it-works, /universe, /download, and the
// same pages in Turkish under /tr/), the opt-in directory of taus, and the relay between
// visitors and web sub-taus.
//
// Contract: docs/reference/tau-universe.md. Decisions: docs/adr/0010, 0013, 0016.
//
// `bun run build` builds the Worker with Vite (vite.config.ts): the server of src/server.ts in
// front, the pages of app/ rendered by vinext (worker/index.ts), into dist/. `wrangler deploy`
// then deploys dist/server/ (Vite points it there).
//
// Do not edit this file for your own deployment: `bun run configure [--route HOST]` copies
// it to the gitignored `wrangler.jsonc`. No hostnames or account ids belong here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tau-universe",
  "main": "./worker/index.ts",
  // The newest date the test runtime (@cloudflare/vitest-pool-workers) supports.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    // The static files: public/ (styles, brand SVGs, fonts, install.sh, with the headers in
    // public/_headers) and, in a build, the pages' bundles under /_next/static/. Vite sets the
    // directory of a build to dist/client; `public` here is what the server's tests serve.
    // Every path without a file reaches the Worker: the pages, the API, tau-host's paths,
    // the universe's card and inbox, and the 404s.
    "directory": "public",
    "binding": "ASSETS"
  },
  "vars": {
    // The universe's own host, which signed requests must name. Empty means "the host of
    // the request URL", which is right for `tau-universe.<subdomain>.workers.dev` and for
    // `wrangler dev`. `bun run configure --route HOST` sets it to HOST.
    "UNIVERSE": "",
    // "1" lets the universe fetch cards of taus at http://localhost or http://127.0.0.1.
    // Development only; `.dev.vars` turns it on for `wrangler dev`.
    "ALLOW_INSECURE_PEERS": "0"
  },
  // The tau app's public downloads (roadmap 190): CI uploads each release to this private
  // bucket, and /download/* serves it (src/downloads.ts). Without the bucket every download
  // is 503. Create it first (`bunx wrangler r2 bucket create tau-downloads`).
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "tau-downloads" }],
  "durable_objects": {
    "bindings": [
      // One instance ("universe") holds the directory: taus, reported links, the replay
      // guard and the rate limit, in its own SQLite database.
      { "name": "DIRECTORY", "class_name": "Directory" },
      // One instance per visitor thread (named by the thread id): its messages and the
      // visits awaiting an answer. An alarm deletes it 24 hours after it began.
      { "name": "RELAY", "class_name": "Relay" }
    ]
  },
  // SQLite-backed classes are the kind the Free plan allows.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Directory"] },
    { "tag": "v2", "new_sqlite_classes": ["Relay"] }
  ],
  // Flood guards, checked before anything that costs a subrequest or a Durable Object call:
  // visitor messages per client IP (POST /api/chat/...), and envelopes per client IP and per
  // claimed sender (POST /net/inbox, as on a spine). Counters are per Cloudflare location
  // and approximate. A namespace_id is shared by every Worker on the account that uses it:
  // `bun run configure --limit-namespaces N` moves the three to N, N+1 and N+2. Without
  // these bindings the universe skips the checks.
  "ratelimits": [
    { "name": "CHAT_IP_LIMIT", "namespace_id": "10601", "simple": { "limit": 10, "period": 60 } },
    { "name": "INBOX_IP_LIMIT", "namespace_id": "10602", "simple": { "limit": 60, "period": 60 } },
    {
      "name": "INBOX_SENDER_LIMIT",
      "namespace_id": "10603",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // `wrangler dev` only.
  "dev": { "ip": "127.0.0.1", "port": 8790 },
  "triggers": {
    // Every hour: drop taus silent for 30 days and prune the rate-limit rows.
    "crons": ["0 * * * *"]
  }
  // A custom domain (optional; `bun run configure --route tau.example.com` does this):
  //   "routes": [{ "pattern": "tau.example.com", "custom_domain": true }]
  // and set UNIVERSE to "tau.example.com". The zone must be on your Cloudflare account.
  //
  // tau-host behind the universe (optional; ADR 0013 §6;
  // `bun run configure --host-service tau-host` does this):
  //   "services": [{ "binding": "HOST", "service": "tau-host" }]
  // The universe then forwards /app, /app/*, /auth/*, /api/host/* and every hosted tau's
  // card and inbox (/@<handle>/.well-known/tau.json, /@<handle>/net/*) to tau-host, and
  // binds handles with POST /api/claim, and relays visitors of hosted web sub-taus to
  // tau-host's visitor API. Without it those paths are 404, claims are 501 and hosted
  // sub-taus cannot be talked to. Deploy tau-host first: a service binding needs the Worker
  // it names.
  //
  // The secret UNIVERSE_IDENTITY (optional; `bun run identity`, then
  // `bunx wrangler secret put UNIVERSE_IDENTITY < .universe-identity`) is the universe's own
  // network identity: its card at /.well-known/tau.json and its inbox at /net/inbox, which
  // relay visitors to web sub-taus that run on hubs. Without it the card is 404, the inbox
  // 503, and only hosted sub-taus can be talked to.
}
