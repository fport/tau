    {
      "id": "net",
      "label": "The tau network",
      "description": "an address for your tau, contacts with other taus, the universe",
      "package": "tau-net",
      "lockstep": false,
      "platforms": [
        "darwin",
        "linux"
      ],
      "available": true,
      "unavailable_reason": null,
      "default": false,
      "advanced": false,
      "permissions": [],
      "requires": [],
      "installed": true,
      "version": "0.1.0",
      "configured": true,
      "state": "done",
      "docs": "https://docs.tau.getporti.com/guides/tau-network/",
      "steps": [
        {
          "id": "init",
          "kind": "command",
          "label": "Create your tau's network identity",
          "interactive": false,
          "optional": false,
          "local_only": false,
          "check": false,
          "command": [
            "net",
            "init"
          ],
          "inputs": [
            {
              "name": "name",
              "label": "Display name on your card (e.g. Alice's tau)",
              "secret": false,
              "required": false,
              "default": ""
            }
          ]
        },
        {
          "id": "spine",
          "kind": "note",
          "label": "Your spine",
          "interactive": false,
          "optional": false,
          "local_only": false,
          "check": false,
          "text": "Your tau's address is a spine, a small Worker in your own Cloudflare account (the free plan is enough). Deploying it needs no Node: tau opens Cloudflare's token page with the right permissions filled in, you create the token and paste it, and tau does the rest through the Cloudflare API. You can skip the next two steps and deploy later.",
          "inputs": []
        },
        {
          "id": "spine-init",
          "kind": "command",
          "label": "Write the spine project",
          "interactive": false,
          "optional": true,
          "local_only": false,
          "check": false,
          "command": [
            "net",
            "spine",
            "init"
          ],
          "inputs": [
            {
              "name": "spine_dir",
              "label": "Directory for the spine project",
              "secret": false,
              "required": true,
              "default": "~/tau-spine"
            },
            {
              "name": "address",
              "label": "Your tau's address, a domain on your Cloudflare account (Enter: workers.dev)",
              "secret": false,
              "required": false,
              "default": ""
            }
          ]
        },
        {
          "id": "spine-deploy",
          "kind": "command",
          "label": "Deploy the spine to Cloudflare",
          "interactive": true,
          "optional": true,
          "local_only": false,
          "check": false,
          "command": [
            "net",
            "spine",
            "deploy"
          ],
          "inputs": [
            {
              "name": "spine_dir",
              "label": "Directory for the spine project",
              "secret": false,
              "required": true,
              "default": "~/tau-spine"
            }
          ]
        },
        {
          "id": "universe",
          "kind": "command",
          "label": "List your tau in the universe",
          "interactive": false,
          "optional": true,
          "local_only": false,
          "check": false,
          "command": [
            "net",
            "universe",
            "join"
          ],
          "inputs": [
            {
              "name": "owner",
              "label": "Your name in the universe",
              "secret": false,
              "required": false,
              "default": ""
            },
            {
              "name": "about",
              "label": "One line about your tau",
              "secret": false,
              "required": false,
              "default": ""
            }
          ]
        },
        {
          "id": "claim",
