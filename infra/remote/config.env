# infra/remote ayarları. Makineye özel değer için config.local.env oluştur (gitignored);
# oradaki değerler buradaki varsayılanları ezer.

TAU_REMOTE_USER="${TAU_REMOTE_USER:-$(id -un)}"
TAU_TMUX_SESSION="${TAU_TMUX_SESSION:-tau}"

# Tailscale adres aralıkları (IPv4 CGNAT + IPv6 ULA). SSH sadece buradan ve localhost'tan kabul edilir.
TAU_TAILNET_V4="${TAU_TAILNET_V4:-100.64.0.0/10}"
TAU_TAILNET_V6="${TAU_TAILNET_V6:-fd7a:115c:a1e0::/48}"

# 010- öneki: sshd ilk bulduğu değeri kullanır, bu dosya macOS'un 100-macos.conf'undan önce okunur.
TAU_SSHD_CONF="${TAU_SSHD_CONF:-/etc/ssh/sshd_config.d/010-tau.conf}"

# 1 = şarjdayken sistem uyumasın (caffeinate -s). TauBar gelince bu görevi o devralacak.
TAU_KEEPAWAKE="${TAU_KEEPAWAKE:-1}"
