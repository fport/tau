{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panel",
  "description": "The panel under the menu bar icon: core events and the menu's own commands; it cannot change how the hub is started.",
  "windows": ["panel"],
  "permissions": [
    "core:default",
    "allow-snapshot",
    "allow-set-sleep-mode",
    "allow-set-launch-at-login",
    "allow-open-login-items",
    "allow-open-log",
    "allow-quit",
    "allow-set-run-hub",
    "allow-open-hub-log",
    "allow-lock-guard",
    "allow-open-camera-settings",
    "allow-open-settings",
    "allow-new-chat",
    "allow-check-updates",
    "allow-panel-fit",
    "allow-panel-hide"
  ]
}
