// tau spine 0.1.0+23e68ef60fa9, local mode: the Wrangler config of the bundled Worker.
// Generated by cloud/spine/scripts/kit.mjs (`pnpm run kit`); do not edit.
//
// `tau net spine init` writes it as wrangler.jsonc; `tau net spine deploy` deploys it.
// Resources without an id (KV, D1) are provisioned on the first deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tau-spine",
  // The bundled Worker, uploaded as it is: no build step.
  "main": "worker.js",
  "no_bundle": true,
  "find_additional_modules": false,
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // ADDRESS: the tau's address; empty means the request host (right for workers.dev).
  "vars": {
    "TAU_MODE": "local",
    "ADDRESS": "",
    "ALLOW_INSECURE_PEERS": "0"
  },
  // A custom domain (a zone on your account): `tau net spine init --address HOST` sets
  // ADDRESS and replaces the next line with the route.
  // "routes": [{ "pattern": "tau.example.com", "custom_domain": true }],
  "kv_namespaces": [
    {
      "binding": "TAU"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tau-spine",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNAL",
        "class_name": "HubSignal"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "HubSignal"
      ]
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
