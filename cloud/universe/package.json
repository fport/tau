{
  "name": "tau-universe",
  "version": "0.1.0",
  "private": true,
  "description": "tau's public site and the tau universe: an opt-in directory of taus and their mutual links",
  "type": "module",
  "scripts": {
    "postinstall": "cd ../shared && bun install --frozen-lockfile",
    "configure": "node scripts/configure.mjs",
    "identity": "node scripts/identity.mjs",
    "build": "node scripts/build.mjs",
    "sync-brand": "node scripts/sync-brand.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client",
    "types": "wrangler types --config wrangler.example.jsonc --env-file .dev.vars.example --include-runtime=false --strict-vars=false"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "~0.22.0",
    "@cloudflare/workers-types": "^5.20260930.1",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-polygon": "^3.0.2",
    "d3-force": "^3.0.0",
    "d3-polygon": "^3.0.1",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3",
    "vitest": "~4.1.11",
    "wrangler": "^4.144.0"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
