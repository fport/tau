{
  "name": "tau-universe",
  "version": "0.1.0",
  "private": true,
  "description": "tau's public site and the tau universe: an opt-in directory of taus and their mutual links",
  "type": "module",
  "scripts": {
    "postinstall": "cd ../shared && bun install --frozen-lockfile",
    "configure": "node scripts/configure.mjs",
    "identity": "node scripts/identity.mjs",
    "build": "node scripts/theme.mjs && vite build",
    "dev": "node scripts/theme.mjs && vite dev --host 127.0.0.1 --port 8790 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 8790 --strictPort",
    "deploy": "bun run build && wrangler deploy",
    "sync-brand": "node scripts/sync-brand.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "types": "wrangler types --config wrangler.example.jsonc --env-file .dev.vars.example --include-runtime=false --strict-vars=false"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62",
    "@cloudflare/vitest-pool-workers": "~0.22.0",
    "@cloudflare/workers-types": "^5.20260930.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "typescript": "^6.0.3",
    "vite": "^8",
    "vitest": "~4.1.11",
    "wrangler": "^4.144.0"
  },
  "trustedDependencies": [
    "workerd"
  ],
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-server-dom-webpack": "^19.2.6",
    "vinext": "^1.0.0"
  }
}
