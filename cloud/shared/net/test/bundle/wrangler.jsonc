// Only for `bun run bundle-check` (wrangler deploy --dry-run): proves that a Worker bundles
// the shared modules and @noble/ciphers. It is never deployed and has no bindings.
{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "tau-shared-bundle-check",
  "main": "worker.ts",
  "compatibility_date": "2026-08-22"
}
