# Copy to .env and fill in your own values. .env is gitignored; this file only holds
# variable names and example values, never real ones.

# --- Remote access (L0): reference values, infra/remote/doctor.sh prints them live ---
TAU_TAILNET=tailXXXXXX.ts.net
TAU_MAC_HOSTNAME=my-mac
TAU_MAC_MAGICDNS=my-mac.tailXXXXXX.ts.net
TAU_MAC_TAILNET_IP=100.x.y.z
TAU_MAC_SSH_HOST_KEY_FP=SHA256:...
TAU_PHONE_HOSTNAME=my-phone
TAU_PHONE_TAILNET_IP=100.x.y.z
TAU_PHONE_SSH_KEY_FP=SHA256:...

# --- Agent (L1): model credentials. Uncomment what you use; tau.toml says which role needs what.
# Bedrock (optional, direct mode only): AWS_REGION plus one of AWS_PROFILE |
# AWS_ACCESS_KEY_ID+AWS_SECRET_ACCESS_KEY | AWS_BEARER_TOKEN_BEDROCK
# AWS_REGION=eu-central-1
# AWS_PROFILE=tau
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=...
# AWS_BEARER_TOKEN_BEDROCK=...
# Anthropic (the only cloud provider, ADR 0009; the proxy reads the same variables). A key that
# is not scoped to a workspace also needs the workspace id (Console → Settings → Workspaces).
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=wrksp_...

# --- Models (L2): the LiteLLM proxy (infra/litellm, ADR 0009). proxy.sh init generates the
# first three; `tau proxy keys` writes one virtual key per model group, carrying its budget.
# LITELLM_MASTER_KEY=sk-...                  # admin key of the proxy (tau proxy keys, rotate)
# LITELLM_SALT_KEY=sk-...                    # encrypts what the proxy stores; never change it after the first start
# TAU_PROXY_DB_PASSWORD=...                  # the proxy's Postgres, reachable only inside compose
# TAU_PROXY_KEY_BRAIN=sk-...                 # virtual key of the brain group (tau proxy keys)
# TAU_PROXY_KEY_FAST=sk-...
# TAU_PROXY_KEY_LOCAL=sk-...
# TAU_PROXY_URL=http://127.0.0.1:4000        # where tau reaches the proxy (default shown)
# TAU_PROXY_PORT=4000                        # loopback port proxy.sh publishes (default shown)
# TAU_OLLAMA_URL=http://my-mac.tailXXXXXX.ts.net:11434   # Ollama when the hub is not the Mac; unset: the Mac itself
# TAU_LOCAL_MODEL=ollama_chat/qwen3.5:9b     # the proxy's local group: ollama_chat/<ollama model name>

# --- Agent (L1): roots and identity. Defaults are shown; set only what differs.
# TAU_HOME=/path/to/tau               # tau.toml, persona/, tools/ (default: cwd with tau.toml, else ~/.tau)
# TAU_DATA_DIR=~/.local/share/tau     # sessions, hub state, logs
# TAU_PROFILE=home                    # home | travel | sport
# TAU_ROLE=hub                        # hub | node
# TAU_HUB_PORT=7877                   # overrides [hub].control_port
# TAU_LANG=en                         # en | tr; UI language, overrides [ui].language (tau --lang does the same)

# --- Access and data (L3): Telegram, polled directly by the hub (ADR 0006). No webhook.
# Bot token from @BotFather (/newbot); the chat ids the bot answers, comma-separated.
# Messages from any other chat are dropped unanswered.
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_ALLOWED_CHAT_IDS=123456789
