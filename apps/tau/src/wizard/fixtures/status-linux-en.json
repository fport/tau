      "configured": false,
      "state": "available",
      "docs": "https://docs.tau.getporti.com/guides/hub-service/",
      "steps": [
        {
          "id": "systemd",
          "kind": "note",
          "label": "A systemd user unit",
          "interactive": false,
          "optional": false,
          "local_only": false,
          "check": false,
          "text": "On Linux the hub runs as a systemd user unit, no sudo needed: mkdir -p ~/.config/systemd/user && tau hub systemd-unit > ~/.config/systemd/user/tau-hub.service && systemctl --user enable --now tau-hub",
          "inputs": []
        }
      ]
    },
    {
      "id": "cloud",
      "label": "Cloud mode",
      "description": "run tau in your own Cloudflare account (installs tau-cloud, then the guide)",
      "package": "tau-cloud",
      "lockstep": false,
      "platforms": [
        "darwin",
        "linux"
      ],
      "available": true,
      "unavailable_reason": null,
      "default": false,
      "advanced": true,
      "permissions": [],
      "requires": [
        "net"
      ],
      "installed": true,
      "version": "0.1.0",
      "configured": true,
      "state": "done",
      "docs": "https://docs.tau.getporti.com/guides/cloud-mode/",
      "steps": [
        {
          "id": "guide",
          "kind": "note",
          "label": "The cloud mode guide",
          "interactive": false,
          "optional": false,
          "local_only": false,
          "check": false,
          "text": "tau-cloud is installed. Cloud mode moves your tau into your own Cloudflare account; the guide walks through it (tau cloud push when you are ready).",
          "inputs": []
        }
      ]
    }
  ]
