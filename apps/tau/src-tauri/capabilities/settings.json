{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window: core events, the folder picker, and the hub, sleep, login, guard and update commands. The only window that may type how the hub is started (the setup wizard can only save the tau its discovery found).",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-snapshot",
    "allow-set-sleep-mode",
    "allow-set-launch-at-login",
    "allow-open-login-items",
    "allow-log-tail",
    "allow-open-log",
    "allow-quit",
    "allow-set-run-hub",
    "allow-save-hub-settings",
    "allow-set-check-updates",
    "allow-open-hub-log",
    "allow-lock-guard",
    "allow-open-camera-settings",
    "allow-new-chat",
    "allow-check-updates",
    "allow-open-wizard"
  ]
}
