// tau spine, local mode (the default deployment mode, ADR 0007).
//
// The hub runs on your own machine; this Worker only serves the tau's public card and
// stores sealed envelopes until the hub acknowledges them. It fits the Workers Free plan
// and runs in `wrangler dev` without Docker.
//
// Do not edit this file for your own deployment: `pnpm run configure` copies it to the
// gitignored `wrangler.jsonc`, and Wrangler writes the ids of the resources it provisions
// on the first deploy into that copy. No resource ids or personal hostnames belong here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The same name in both example configs, so switching modes keeps the
  // `tau-spine.<subdomain>.workers.dev` address and the data.
  "name": "tau-spine",
  "main": "src/index.ts",
  // The newest date the test runtime (@cloudflare/vitest-pool-workers) supports.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    // `local` keeps the life-data routes (/hub/state, /hub/files, /hub/sessions,
    // /hub/brain) switched off: they answer 404 cloud_mode_off.
    "TAU_MODE": "local",
    // The tau's address. Empty means "the host of the request URL", which is right for
    // `tau-spine.<subdomain>.workers.dev`. Set it when a custom domain fronts the Worker.
    "ADDRESS": "",
    // "1" lets this spine fetch cards of peers at http://localhost or http://127.0.0.1.
    // Development only; `.dev.vars` turns it on for `wrangler dev`.
    "ALLOW_INSECURE_PEERS": "0"
  },
  // No id: Wrangler provisions the namespace on the first deploy. It holds the card,
  // cached peer cards (`peer:<address>`, one hour) and, in cloud mode, the config files.
  "kv_namespaces": [{ "binding": "TAU" }],
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: provisioned (or looked up by this name) on the first deploy.
      "database_name": "tau-spine",
      // Applied by `pnpm dev` (locally) and `pnpm run deploy` (remotely).
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    // One instance ("hub") wakes the hub's waiting long poll when an envelope arrives.
    "bindings": [{ "name": "SIGNAL", "class_name": "HubSignal" }]
  },
  // SQLite-backed classes are the kind the Free plan allows.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HubSignal"] }],
  // `wrangler dev` only: the address a local hub and other local spines use.
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "triggers": {
    // Every minute: prune old mailbox and replay-guard rows.
    "crons": ["* * * * *"]
  }
  // A custom domain (optional): add
  //   "routes": [{ "pattern": "tau.example.com", "custom_domain": true }]
  // and set ADDRESS to "tau.example.com". The zone must be on your Cloudflare account.
}
