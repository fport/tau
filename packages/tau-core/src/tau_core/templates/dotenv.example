# Copy to .env and fill in your own values. .env is gitignored; this file only holds
# variable names and example values, never real ones.

# --- Agent (L1): model credentials. Uncomment what you use; tau.toml says which role needs what.
# Bedrock: AWS_REGION plus one of AWS_PROFILE | AWS_ACCESS_KEY_ID+AWS_SECRET_ACCESS_KEY | AWS_BEARER_TOKEN_BEDROCK
# AWS_REGION=eu-central-1
# AWS_PROFILE=tau
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=...
# AWS_BEARER_TOKEN_BEDROCK=...
# Anthropic (the brain role's fallback). A key that is not scoped to a workspace also
# needs the workspace id (Console → Settings → Workspaces), otherwise the API answers 400.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=wrksp_...

# --- Agent (L1): roots and identity. Defaults are shown; set only what differs.
# TAU_HOME=/path/to/tau               # tau.toml, persona/, tools/ (default: cwd with tau.toml, else ~/.tau)
# TAU_DATA_DIR=~/.local/share/tau     # sessions, hub state, logs
# TAU_PROFILE=home                    # home | travel | sport
# TAU_ROLE=hub                        # hub | node
# TAU_HUB_PORT=7877                   # overrides [hub].control_port
# TAU_LANG=en                         # en | tr; UI language, overrides [ui].language (tau --lang does the same)
