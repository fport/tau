# infra/remote settings. For machine-specific values create config.local.env (gitignored);
# its values override the defaults here.

TAU_REMOTE_USER="${TAU_REMOTE_USER:-$(id -un)}"
TAU_TMUX_SESSION="${TAU_TMUX_SESSION:-tau}"

# Tailscale address ranges (IPv4 CGNAT + IPv6 ULA). SSH is accepted only from here and from localhost.
TAU_TAILNET_V4="${TAU_TAILNET_V4:-100.64.0.0/10}"
TAU_TAILNET_V6="${TAU_TAILNET_V6:-fd7a:115c:a1e0::/48}"

# The 010- prefix: sshd uses the first value it finds, and this file is read before macOS's 100-macos.conf.
TAU_SSHD_CONF="${TAU_SSHD_CONF:-/etc/ssh/sshd_config.d/010-tau.conf}"

# 1 = keep the system awake while on AC power (caffeinate -s). Ignored once TauBar is installed:
# TauBar holds the same PreventSystemSleep assertion, and setup.sh then removes this agent.
TAU_KEEPAWAKE="${TAU_KEEPAWAKE:-1}"

# Where TauBar.app is looked for (empty: /Applications, then ~/Applications).
TAU_TAUBAR_APP="${TAU_TAUBAR_APP:-}"
