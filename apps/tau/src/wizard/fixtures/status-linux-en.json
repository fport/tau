          "label": "Your first sub-tau",
          "interactive": false,
          "optional": false,
          "local_only": false,
          "check": false,
          "text": "Create one when you like: tau sub new coach --describe \"a patient running coach\". Then /coach in tau tui, or tau sub chat coach.",
          "inputs": []
