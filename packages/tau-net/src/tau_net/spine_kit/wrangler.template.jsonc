// tau spine 0.2.0+719ea6c82176, local mode: the Wrangler config of the bundled Worker.
// Generated by cloud/spine/scripts/kit.mjs (`bun run kit`); do not edit.
//
// `tau net spine init` writes it as wrangler.jsonc; `tau net spine deploy` deploys it.
// Storage bindings without an id are provisioned on the first deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tau-spine",
  // The bundled Worker, uploaded as it is: no build step.
  "main": "worker.js",
  "no_bundle": true,
  "find_additional_modules": false,
  "compatibility_date": "2026-08-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // ADDRESS: the tau's address; empty means the request host (right for workers.dev).
  "vars": {
    "TAU_MODE": "local",
    "ADDRESS": "",
    "ALLOW_INSECURE_PEERS": "0"
  },
  // A custom domain (a zone on your account): `tau net spine init --address HOST` sets
  // ADDRESS and replaces the next line with the route.
  // "routes": [{ "pattern": "tau.example.com", "custom_domain": true }],
  "kv_namespaces": [
    {
      "binding": "TAU"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MAILBOX",
        "class_name": "Mailbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Mailbox"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "INBOX_IP_LIMIT",
      "namespace_id": "10501",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "INBOX_SENDER_LIMIT",
      "namespace_id": "10502",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
