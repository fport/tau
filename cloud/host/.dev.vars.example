# Local development values for `wrangler dev`. `pnpm run configure` copies this file to
# `.dev.vars` (gitignored) when it is missing and fills VAULT_KEY with 32 fresh random bytes.
# Never put real secrets in this example file.

# Password-less sign-in on http://127.0.0.1 and http://localhost only (a form on the landing page).
DEV_LOGIN=1
# The scripted `fake` provider: no key, no cost, predictable replies.
FAKE_PROVIDER=1
# Anyone may create an account locally.
SIGNUP=open

# Secrets. For GitHub sign-in in `wrangler dev`, create an OAuth App with the callback
# http://127.0.0.1:8791/auth/callback, put its client id into GITHUB_CLIENT_ID in
# wrangler.jsonc and its secret here.
GITHUB_CLIENT_SECRET=
# 32 random bytes, base64url (43 characters). `pnpm run configure` generates one.
VAULT_KEY=
