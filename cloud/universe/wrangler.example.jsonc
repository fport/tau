// tau universe: the public site (landing page, /how-it-works, /universe, and the same pages in
// Turkish under /tr/) and the opt-in directory of taus.
//
// Contract: docs/reference/tau-universe.md. Decision: docs/adr/0010.
//
// Do not edit this file for your own deployment: `pnpm run configure [--route HOST]` copies
// it to the gitignored `wrangler.jsonc`. No hostnames or account ids belong here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tau-universe",
  "main": "src/index.ts",
  // The newest date the test runtime (@cloudflare/vitest-pool-workers) supports.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Bundles the universe page's script (d3-force) and copies the web fonts into
  // public/app/ (gitignored). `wrangler dev` and `wrangler deploy` run it first.
  "build": {
    "command": "node scripts/build.mjs",
    "watch_dir": "client"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // The Worker answers the API and every page, in English and in Turkish (to add the
    // security headers and handle the language choice; src/pages.ts lists the pages, and a
    // test keeps this list in step). Every other file (styles, scripts, brand SVGs, fonts)
    // is served straight from the asset store with the headers in public/_headers. Paths
    // that match no file reach the Worker, which answers the 404 page of their language.
    "run_worker_first": [
      "/api/*",
      "/",
      "/how-it-works",
      "/universe",
      "/tr",
      "/tr/",
      "/tr/how-it-works",
      "/tr/universe"
    ]
  },
  "vars": {
    // The universe's own host, which signed requests must name. Empty means "the host of
    // the request URL", which is right for `tau-universe.<subdomain>.workers.dev` and for
    // `wrangler dev`. `pnpm run configure --route HOST` sets it to HOST.
    "UNIVERSE": "",
    // "1" lets the universe fetch cards of taus at http://localhost or http://127.0.0.1.
    // Development only; `.dev.vars` turns it on for `wrangler dev`.
    "ALLOW_INSECURE_PEERS": "0"
  },
  "durable_objects": {
    // One instance ("universe") holds the directory: taus, reported links, the replay
    // guard and the rate limit, in its own SQLite database.
    "bindings": [{ "name": "DIRECTORY", "class_name": "Directory" }]
  },
  // SQLite-backed classes are the kind the Free plan allows.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory"] }],
  // `wrangler dev` only.
  "dev": { "ip": "127.0.0.1", "port": 8790 },
  "triggers": {
    // Every hour: drop taus silent for 30 days and prune the rate-limit rows.
    "crons": ["0 * * * *"]
  }
  // A custom domain (optional; `pnpm run configure --route tau.example.com` does this):
  //   "routes": [{ "pattern": "tau.example.com", "custom_domain": true }]
  // and set UNIVERSE to "tau.example.com". The zone must be on your Cloudflare account.
}
